{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bsommers/secure-design-patterns/schema/pattern.schema.json",
  "title": "SecureDesignPatternCatalog",
  "description": "Machine-verifiable schema for specification-grounded Secure Design Pattern catalogs.",
  "type": "object",
  "required": ["domain", "title", "spec_version", "updated_at", "patterns"],
  "additionalProperties": false,
  "properties": {
    "domain": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "spec_version": {
      "type": "string",
      "minLength": 3
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/PatternEntry"
      }
    }
  },
  "$defs": {
    "PatternEntry": {
      "type": "object",
      "required": [
        "id",
        "slug",
        "title",
        "status",
        "severity",
        "markdown_file",
        "failure_mode",
        "invariants",
        "anti_patterns",
        "authority_ids",
        "cwe_ids",
        "owasp_ids",
        "verification_gates",
        "field_origin"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{2,8}-\\d{3}$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 5
        },
        "status": {
          "type": "string",
          "enum": ["canonical", "draft", "deprecated"]
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium"]
        },
        "markdown_file": {
          "type": "string",
          "pattern": "^[A-Z0-9-]+-[a-z0-9-]+\\.md$"
        },
        "reference_module": {
          "type": "string"
        },
        "failure_mode": {
          "type": "string",
          "minLength": 20
        },
        "invariants": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 10 }
        },
        "anti_patterns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 10 }
        },
        "authority_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[A-Z0-9._:-]+$" }
        },
        "cwe_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^CWE-\\d+$" }
        },
        "owasp_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^OWASP-(API|LLM)\\d{1,2}:\\d{4}$" }
        },
        "verification_gates": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 10 }
        },
        "field_origin": {
          "type": "object",
          "required": ["repository", "evidence"],
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string" },
            "evidence": { "type": "string", "minLength": 10 }
          }
        }
      }
    }
  }
}
